{
  "name": "yiduo-yixing",
  "private": true,
  "version": "1.1.0",
  "description": "一朵一星 1.1 —— 55 款原创小游戏合集(188 关战役 / 双人 / 无尽)",
  "author": "yiduo-yixing",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "electron:dev": "bash scripts/electron-dev.sh",
    "dist": "bash scripts/build-desktop.sh",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:win:nsis": "npm run build && electron-builder --win nsis",
    "dist:win:all": "bash scripts/dist-win.sh",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "android:sync": "npm run build && NODE_OPTIONS=--experimental-strip-types cap sync android",
    "android:apk": "bash scripts/build-android.sh"
  },
  "build": {
    "appId": "com.yiduoyixing.hub",
    "productName": "一朵一星",
    "artifactName": "yiduo-yixing-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "public/icons/icon-512.png",
      "maintainer": "yiduo-yixing"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "public/icons/icon-512.png",
      "identity": null,
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-256.png"
    },
    "portable": {
      "artifactName": "yiduo-yixing-${version}-win-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "yiduo-yixing-${version}-win-setup.${ext}"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  }
}
